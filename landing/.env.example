# Variables de entorno requeridas para el sitio.
# Copia este archivo como .env para desarrollo local.
# NUNCA subas .env a git — está en .gitignore.

# Mailgun (solo necesario si se reactiva el endpoint /api/contact con SSR)
# Configura esta variable en Netlify → Site configuration → Environment variables
MAILGUN_API_KEY=your-mailgun-api-key-here
