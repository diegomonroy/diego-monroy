---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="contact" class="w-full py-12 border-t border-[#ffffff10]">
	<div class="max-w-5xl mx-auto">
		<h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">{t('contact.subtitle')}</h2>
		<h3 class="text-4xl md:text-5xl font-medium text-[var(--white)] mb-6">{t('contact.title')}</h3>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
			<div class="text-[var(--white-icon)]">
				<p class="mb-4">
					{t('contact.desc')}
				</p>
				<div class="flex items-center gap-2">
					<span>{t('contact.location.label')}</span>
					<span class="text-[var(--white)]">{t('contact.location.value')}</span>
				</div>
			</div>
			<div>
				<form
					id="contact-form"
					class="flex flex-col gap-4"
					data-msg-sending={t('contact.form.sending')}
					data-msg-send={t('contact.form.send')}
					data-msg-wait={t('contact.form.wait')}
					data-msg-error={t('contact.form.error')}
					data-msg-subject={t('contact.form.subject')}
				>
					<input type="hidden" name="access_key" value="b41ea4e3-1d34-4ae5-9a57-77a44170229e" />
					<!-- Honeypot: invisible field for bots; Web3Forms rejects submissions with this field filled -->
					<input type="text" name="botcheck" style="display:none;" tabindex="-1" autocomplete="off" />
					<input
						type="text"
						name="from_name"
						placeholder={t('contact.form.name')}
						required
						class="px-4 py-2 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)]"
					/>
					<input
						type="email"
						name="reply_to"
						placeholder={t('contact.form.email')}
						required
						class="px-4 py-2 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)]"
					/>
					<textarea
						name="message"
						placeholder={t('contact.form.message')}
						rows="6"
						required
						class="px-4 py-2 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)] resize-none"
					></textarea>
					<button
						type="submit"
						class="px-4 py-2 bg-[var(--white-icon-tr)] text-[var(--white)] rounded-lg opacity-60 transition-opacity border border-[var(--white-icon-tr)] hover:opacity-100 hover:bg-[var(--white-icon-tr)]"
					>
						{t('contact.form.send')}
					</button>
				</form>
				<div
					id="form-message"
					class="hidden justify-center items-center mt-4 text-[var(--white)] text-lg"
				>
					{t('contact.form.success')}
				</div>
			</div>
		</div>
	</div>
</section>

<script type="module" is:inline>
	const form = document.getElementById( "contact-form" );
	const formMessage = document.getElementById( "form-message" );
	const submitBtn = form.querySelector( "button[type='submit']" );
	// Rate limiting: max 1 submission every 60 seconds per session
	const RATE_LIMIT_MS = 60_000;
	let lastSubmitTime = 0;
	let isSubmitting = false;
	form.addEventListener( "submit", async ( e ) => {
		e.preventDefault();
		// Prevent double submission
		if ( isSubmitting ) return;
		// Rate limiting client-side
		const now = Date.now();
		if ( now - lastSubmitTime < RATE_LIMIT_MS ) {
			const secsLeft = Math.ceil( ( RATE_LIMIT_MS - ( now - lastSubmitTime ) ) / 1000 );
			alert( form.dataset.msgWait.replace('{secs}', secsLeft.toString()) );
			return;
		}
		// Lock button during submission
		isSubmitting = true;
		submitBtn.disabled = true;
		submitBtn.textContent = form.dataset.msgSending;
		const formData = new FormData( form );
		// Honeypot check client-side (second layer)
		if ( formData.get( "botcheck" ) ) return;
		const data = {
			access_key: formData.get( "access_key" ),
			name: formData.get( "from_name" ),
			email: formData.get( "reply_to" ),
			message: formData.get( "message" ),
			subject: form.dataset.msgSubject,
			botcheck: formData.get( "botcheck" ),
		};
		try {
			const response = await fetch( "https://api.web3forms.com/submit", {
				method: "POST",
				headers: { "Content-Type": "application/json", Accept: "application/json" },
				body: JSON.stringify( data ),
			} );
			const result = await response.json();
			if ( result.success ) {
				lastSubmitTime = Date.now();
				form.reset();
				form.style.display = "none";
				formMessage.classList.remove( "hidden" );
				formMessage.classList.add( "flex" );
			} else {
				alert( form.dataset.msgError );
			}
		} catch ( error ) {
			console.error( "Error:", error );
			alert( form.dataset.msgError );
		} finally {
			isSubmitting = false;
			submitBtn.disabled = false;
			submitBtn.textContent = form.dataset.msgSend;
		}
	} );
</script>
